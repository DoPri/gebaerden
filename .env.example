# Copy to .env and fill in. Everything the build and the release read comes
# from here, so one file holds it all:
#     source .env

# Android SDK, needed for adb, the emulator and the screenshot capture.
export ANDROID_HOME="$HOME/Android/Sdk"
export PATH="$ANDROID_HOME/tools:$ANDROID_HOME/tools/bin:$ANDROID_HOME/platform-tools:$PATH"

# The upload key. Without these the release build stays unsigned, which is
# what F-Droid wants and what Play refuses. See RELEASING.md.
export ANDROID_KEYSTORE="$PWD/release.jks"
export ANDROID_KEYSTORE_PASSWORD="TODO"
export ANDROID_KEY_ALIAS="gebaerden"
export ANDROID_KEY_PASSWORD="TODO"

# The Play service account for fastlane. Point this at the JSON file Google
# handed you. Leave it empty to sign in with gcloud instead. See RELEASING.md.
export PLAY_SERVICE_ACCOUNT_FILE="$PWD/play-service-account.json"

# The OAuth client for tools/youtube.py, a separate one. Download the JSON in
# the Cloud console and point this at it. See RELEASING.md.
export YOUTUBE_CLIENT_SECRET_FILE="$PWD/youtube-client.json"
