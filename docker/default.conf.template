# Included from the http block of the image's nginx.conf.

# There is a reverse proxy in front, so the client address arrives in a header.
# Only the private ranges a container network hands out are believed.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# signdict.org is volunteer run. One client cannot hammer it through here.
limit_req_zone $binary_remote_addr zone=dgsapi:10m rate=5r/s;

server {
    listen 8080;
    listen [::]:8080;

    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json application/wasm image/svg+xml text/css;

    # Every header sits here. A single add_header inside a location would drop
    # all of these for that location, which is how such a list quietly rots.
    #
    # Nothing in a Flutter build carries a hash in its name, so no answer may
    # be cached without asking. ETag turns the asking into a 304.
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # The videos and the stills come straight from the SignDict CDN, the API
    # answers on this origin. wasm-unsafe-eval is what CanvasKit and sqlite3
    # need, blob: is where the drift worker and the decoded clips live.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://assets.wishlephant.com; media-src 'self' blob: https://assets.wishlephant.com; connect-src 'self'; font-src 'self' data:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API on the app's own origin. signdict.org sends no CORS header, and
    # a browser asks for none when the address is its own.
    location = /api {
        limit_req zone=dgsapi burst=20 nodelay;

        # Resolved per request rather than once at start. A changed address
        # needs no restart, and a DNS that is not up yet does not keep nginx
        # from starting at all. The entrypoint fills in whatever the container
        # has, which is not the same on a default bridge and a named network.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
